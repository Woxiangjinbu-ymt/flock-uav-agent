digraph EvidenceScopedMissionControl {
  graph [
    rankdir=TB,
    splines=polyline,
    compound=true,
    newrank=true,
    bgcolor="white",
    pad="0.25",
    nodesep="0.38",
    ranksep="0.64",
    fontname="Helvetica",
    fontsize=18,
    labelloc=t,
    label="Proposed Evidence-Scoped Multi-UAV Harness"
  ];
  node [
    shape=box,
    style="rounded,filled",
    fontname="Helvetica",
    fontsize=10,
    color="#94A3B8",
    fontcolor="#17212F",
    fillcolor="white",
    margin="0.16,0.11",
    penwidth=1.1
  ];
  edge [
    fontname="Helvetica",
    fontsize=9,
    fontcolor="#334155",
    color="#64748B",
    arrowsize=0.7,
    penwidth=1.25
  ];

  subgraph cluster_task {
    label="MISSION REQUIREMENTS";
    labelloc=t;
    fontsize=11;
    fontname="Helvetica-Bold";
    fontcolor="#1E3A5F";
    color="#B5CCE8";
    fillcolor="#F5F9FF";
    style="rounded,filled";

    mission [label="Natural-language\nmission", fillcolor="#E3EEFF", color="#79A9E8"];
    obligations [label="Source-linked obligation graph\nactor · object · action · order · end state\nambiguous clauses remain explicit", fillcolor="#E3EEFF", color="#79A9E8"];
    mission -> obligations [label="conservative parsing", color="#3F78BC"];
  }

  subgraph cluster_evidence {
    label="LEGAL EVIDENCE  •  SCENE-SCOPED / TASK-SCOPED";
    labelloc=t;
    fontsize=11;
    fontname="Helvetica-Bold";
    fontcolor="#0A665C";
    color="#A6DAD2";
    fillcolor="#F4FCFA";
    style="rounded,filled";

    observations [label="Local observations + actual receipts\nID/position · name-only contact · tool effect", fillcolor="#E5F6F2", color="#69B9AA"];
    events [label="Append-only event record\nsource · observer · actor · time · confirmed path", fillcolor="#E5F6F2", color="#69B9AA"];
    evidence [label="Typed evidence state\nexact location | feasible corridor | unknown\nactor-scoped effect | source | freshness", fillcolor="#E5F6F2", color="#69B9AA"];
    observations -> events -> evidence [color="#168B7D"];
  }

  subgraph cluster_control {
    label="";
    labelloc=t;
    fontsize=11;
    fontname="Helvetica-Bold";
    fontcolor="#875300";
    color="#E8CF91";
    fillcolor="#FFFBF1";
    style="rounded,filled";

    join [label="Obligation–evidence match\nWhat is known? Who acted? What is proven?", fillcolor="#FFF0C9", color="#DBA84E"];
    gaps [label="Next unresolved gap\nLOCATE  |  ACT  |  CONFIRM", fillcolor="#FFF0C9", color="#DBA84E"];
    controller [label="Budget-aware fleet controller\none main agent; bounded action selection", fillcolor="#FFE8AD", color="#D99A2B"];
    budget [label="Remaining time · battery\nAPI / token cost", fillcolor="#FFF7E2", color="#DBA84E"];
    join -> gaps -> controller [color="#B7790A", penwidth=1.6];
    budget -> controller [color="#B7790A"];
  }

  subgraph cluster_action {
    label="";
    labelloc=t;
    fontsize=11;
    fontname="Helvetica-Bold";
    fontcolor="#5D3D83";
    color="#C8B7DA";
    fillcolor="#FBF8FF";
    style="rounded,filled";

    locate [label="Scout / localize\nauxiliary UAVs may search", fillcolor="#F0E8F9", color="#AC8FCE"];
    act [label="Execute obligation\nrequired UAV + original order", fillcolor="#F0E8F9", color="#AC8FCE"];
    confirm [label="Public evidence probe\ncheck actual state; abstain if unknown", fillcolor="#F0E8F9", color="#AC8FCE"];
    dispatcher [label="Per-UAV queues + typed tools\nparallel across UAVs; ordered per UAV", fillcolor="#EADCF6", color="#9A76C3"];
    api [label="Agent-visible UAV API\nlocal sensing + actions + public progress", fillcolor="#EADCF6", color="#9A76C3"];

    {rank=same; locate; act; confirm;}
    locate -> dispatcher [color="#8660AD"];
    act -> dispatcher [color="#8660AD"];
    confirm -> dispatcher [color="#8660AD"];
    dispatcher -> api [color="#8660AD", penwidth=1.6];
  }

  obligations -> join [color="#3F78BC", penwidth=1.6];
  evidence -> join [color="#168B7D", penwidth=1.6];
  controller -> locate [label="information gap", color="#8660AD"];
  controller -> act [label="execution gap", color="#8660AD"];
  controller -> confirm [label="proof gap", color="#8660AD"];
  api -> observations [label="real result, not intent", color="#168B7D", penwidth=1.8, constraint=false];

  finish [label="Stop + report unresolved items", fillcolor="#EEF2F7", color="#94A3B8"];
  offline [label="Freeze world → hidden checker\nexternal scoring only", style="rounded,dashed,filled", fillcolor="#F7F8FA", color="#A0A9B5"];
  controller -> finish [label="done / deadline", color="#64748B"];
  finish -> offline [style=dashed, color="#94A3B8"];
}
