digraph DecisionApplicabilityHarness {
  graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.55,
         fontname="Helvetica", fontsize=17, labelloc=t,
         label="Proposed Harness: Monitor the Applicability of Committed Plans\nDesign revision from the 2026-10-15 trace audit; not yet validated"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11,
        color="#94A3B8", fillcolor="#F8FAFC", fontcolor="#17212F", margin="0.17,0.12"];
  edge [fontname="Helvetica", fontsize=9, color="#64748B", arrowsize=0.7];
  task [label="Original task + public evidence\nactor / object / order / end condition", fillcolor="#DBEAFE"];
  model [label="Main model\ncreate or revise the affected plan", fillcolor="#DBEAFE"];
  plan [label="Committed plan + execution cursor\nsource obligations / evidence dependencies\nguards / repair scope / budget", fillcolor="#FEF3C7"];
  gate [label="Applicability monitor\nvalid / unknown / invalid\nWhich branch is affected?", fillcolor="#FEF3C7"];
  execute [label="CONTINUE\nbounded skill + local repair\nindependent UAV branches", fillcolor="#DCFCE7"];
  observe [label="OBSERVE\nresolve a specific public-state gap\nbounded queries", fillcolor="#CCFBF1"];
  replan [label="REPLAN\nno usable plan / unhandled invalidation\nrepair or observation budget exhausted", fillcolor="#FFE4E6"];
  tools [label="Shared public tools and APIs\nsame capabilities in every scheduling arm"];
  events [label="Actual receipts + append-only evidence\nscene / task / actor / effect / time\npartial path remains partial", fillcolor="#CCFBF1"];
  finish [label="Public stop-condition check\nreport remaining unsupported obligations"];
  checker [label="Hidden benchmark evaluation\nafter the action window only", style="rounded,dashed", fillcolor="white"];
  task -> model;
  model -> plan [label="explicit commitment"];
  plan -> gate;
  gate -> execute [label="valid or locally repairable", color="#16A34A"];
  gate -> observe [label="resolvable uncertainty", color="#0D9488"];
  gate -> replan [label="needs a new decision", color="#DC2626"];
  replan -> model [constraint=false, label="affected branch + evidence"];
  execute -> tools;
  observe -> tools;
  tools -> events;
  events -> gate [constraint=false, label="update relevant dependencies"];
  execute -> finish [label="skill stop condition"];
  finish -> checker [style=dashed, label="evaluation only"];
  {rank=same; execute; observe; replan;}
}
